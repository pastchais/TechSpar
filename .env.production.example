# TechSpar production example
ENV=production
PUBLIC_BASE_URL=https://stu.6bits.de
CORS_ORIGINS=["https://stu.6bits.de"]
ALLOW_REGISTRATION=false
JWT_SECRET=replace-with-a-long-random-secret
DEFAULT_EMAIL=admin@stu.6bits.de
DEFAULT_PASSWORD=replace-with-a-strong-password
DEFAULT_NAME=Admin
UPLOAD_MAX_MB=20
MIN_CONFIDENCE_TO_PERSIST=0.6
WEAK_POINT_PROMOTE_THRESHOLD=2

# Fill these according to your model provider
API_BASE=
API_KEY=
MODEL=
TEMPERATURE=0.2

# Optional embedding API; leave empty to use local HF model
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
